{
  "name": "inwards-tool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --env-file=.env.local --test tests/*.test.ts",
    "test:http": "tsx --env-file=.env.local scripts/check-http.ts",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "user:create": "tsx --env-file-if-exists=.env.local scripts/create-user.ts",
    "user:bootstrap": "tsx --env-file-if-exists=.env.local scripts/create-user.ts --if-empty"
  },
  "dependencies": {
    "@zxing/browser": "0.2.1",
    "next": "16.3.4",
    "pg": "^8.22.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/pg": "^8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tsx": "^4",
    "typescript": "^5"
  }
}
